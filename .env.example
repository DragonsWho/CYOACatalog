# Copy to .env and fill in. Never commit .env.
# The Go binary reads this file at startup; every variable is optional unless noted.

# Runtime mode: "development" → proxy to Vite on :8091; anything else → embedded SPA
NODE_ENV=

# Public base URL of the instance, used to build absolute links (emails, push, SEO).
# Example: https://example.com
PB_APP_URL=

# Auth tracing log level: trace | debug | info | warn | error
PB_LOG_LEVEL=info
# Set to "1" to force debug regardless of PB_LOG_LEVEL
PB_DEBUG=

# Cloudflare Turnstile — server-side secret key
# https://dash.cloudflare.com/<account>/turnstile
TURNSTILE_SECRET_KEY=
# Cloudflare Turnstile — client-side site key (used in hosted-game claim page)
TURNSTILE_SITE_KEY=

# Cloudflare cache purge (used by the hosting upload handler)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Site chat (shoutbox). Empty/0 → all chat endpoints return 404 and the UI is hidden.
SHOUTBOX_ENABLED=
# Salt for anon_key. Must be set to your own value in production: without it an
# anonymous user's key can be recovered from their IP by brute force.
SHOUTBOX_ANON_SALT=
# Comma-separated stop words (the actual list is kept outside the repository).
SHOUTBOX_WORD_FILTER=

# Web push (VAPID). Generate the pair once: ./dist/serve push-keys
# Rotating these invalidates ALL existing subscriptions — browsers will not reissue them.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Cloudflare R2 — game hosting storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Concurrency limiter: max in-flight requests before the server sheds load.
# Empty → built-in default (see overload.go).
OVERLOAD_MAX_INFLIGHT=

# --- SQLite tuning (see main.go; empty → built-in defaults) ---
# Page cache per connection, in KB. SQLite allocates this PER OPEN CONNECTION,
# so cache × max_open_conns is the real memory ceiling. Raising it without
# lowering the connection limits is how a small server ends up thrashing.
PB_SQLITE_CACHE_KB=
# Connection pool for the main database
PB_DATA_MAX_OPEN_CONNS=
PB_DATA_MAX_IDLE_CONNS=
# Connection pool for the auxiliary database (logs)
PB_AUX_MAX_OPEN_CONNS=
PB_AUX_MAX_IDLE_CONNS=

# Address for the pprof profiling listener, e.g. 127.0.0.1:6060.
# Empty → profiling disabled. Never bind to 0.0.0.0.
PPROF_ADDR=

# --- Deployment (used by the Makefile, not by the binary) ---
# SSH target for `make ship`, e.g. root@your-server
SSH_HOST=

# ---------------------------------------------------------------------------
# Semantic search (semantic-search/, a separate FastAPI service on port 8100)
# Read from the environment of that service, not by the Go binary.
# ---------------------------------------------------------------------------
# Google AI Studio key used to produce embeddings. GOOGLE_API_KEY also works.
GEMINI_API_KEY=
# Embedding model. Changing it invalidates the whole index — rebuild from scratch.
EMBED_MODEL=gemini-embedding-001
# Seconds between embedding calls, to stay inside the API quota. The free tier
# needs ~35; a paid key can go to 0.5, which is what the service unit sets.
EMBED_MIN_INTERVAL=0.5
# How often to pull new games from PocketBase and embed them, in hours.
SYNC_HOURS=1
# Set to any non-empty value to force a sync on start, ignoring SYNC_HOURS.
SYNC_FORCE=
# "Similar games" block: how many neighbours, and the cosine floor below which
# a neighbour is considered unrelated and dropped.
SIMILAR_TOP_K=12
SIMILAR_MIN_COS=0.55
# Per-client rate limit: at most RATE_MAX requests per RATE_WINDOW seconds.
RATE_MAX=60
RATE_WINDOW=60
