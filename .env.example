# Runtime mode: "development" → proxy to Vite on :8091; anything else → embedded SPA
NODE_ENV=

# Auth tracing log level: trace | debug | info | warn | error
PB_LOG_LEVEL=info
# Set to "1" to force debug regardless of PB_LOG_LEVEL
PB_DEBUG=

# Cloudflare Turnstile — server-side secret key
# https://dash.cloudflare.com/<account>/turnstile
TURNSTILE_SECRET_KEY=
# Cloudflare Turnstile — client-side site key (used in hosted-game claim page)
TURNSTILE_SITE_KEY=

# Cloudflare cache purge (used by the hosting upload handler)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Site chat (shoutbox). Empty/0 → all chat endpoints 404 and the frontend hides the UI.
SHOUTBOX_ENABLED=
# Salt for anon_key. Must be unique in production: without it an anon key can be
# brute-forced back to the IP.
SHOUTBOX_ANON_SALT=
# Comma-separated stop words (the list is kept out of the repo).
SHOUTBOX_WORD_FILTER=

# Web push (VAPID). Generate the pair once: ./dist/serve push-keys
# Changing keys invalidates ALL existing subscriptions — browsers will not reissue them.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@cyoa.cafe

# Cloudflare R2 — game hosting storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
